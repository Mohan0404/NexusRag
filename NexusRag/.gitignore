# =====================================================================
# NexusRAG Git Ignore Configuration
# Covers Python Backend, React Frontend, ChromaDB, Staging, & OS
# =====================================================================

# ---------------------------------------------------------------------
# Python Caches & Bytecode
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ---------------------------------------------------------------------
# Virtual Environments
# ---------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ---------------------------------------------------------------------
# Environment Variables & Secrets
# ---------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly keep example environment templates
!.env.example
!backend/.env.example
!frontend/.env.example

# ---------------------------------------------------------------------
# Vector Database & Local Data Storage
# ---------------------------------------------------------------------
# ChromaDB persistence & SQLite databases
**/data/chroma/
chroma/
chroma_db/
chromadb/
*.sqlite3
*.sqlite3-journal

# Staged uploads & local document storage
**/data/uploads/*
!**/data/uploads/.gitkeep
**/data/documents/*
!**/data/documents/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# ---------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------
# Testing & Code Quality Caches
# ---------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/
coverage/
frontend/coverage/
.vitest/

# ---------------------------------------------------------------------
# Node & Frontend Build Artifacts
# ---------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.eslintcache

# ---------------------------------------------------------------------
# IDE, Editors & OS Metadata
# ---------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.tmp
*.bak
