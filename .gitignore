# =====================================================================
# NexusRAG Root Git Ignore Configuration
# Applies repository-wide across Root, Backend, Frontend, and Tests
# =====================================================================

# ---------------------------------------------------------------------
# Python Virtual Environments
# ---------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.Python

# ---------------------------------------------------------------------
# Python Caches & Bytecode
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ---------------------------------------------------------------------
# Environment Variables & Secrets
# ---------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly keep example environment templates
!.env.example
!**/.env.example

# ---------------------------------------------------------------------
# Vector Databases, ChromaDB & Local Persistence
# ---------------------------------------------------------------------
**/chroma/
**/chroma_db/
**/chromadb/
**/data/chroma/
*.sqlite3
*.sqlite3-journal

# Upload staging & local document ingestion caches
**/data/uploads/*
!**/data/uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep
**/data/documents/*
!**/data/documents/.gitkeep

# ---------------------------------------------------------------------
# Logs & Process Outputs
# ---------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------
# Testing, Coverage & Quality Tooling Caches
# ---------------------------------------------------------------------
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.hypothesis/
coverage/
**/coverage/
.vitest/
**/.vitest/

# ---------------------------------------------------------------------
# Node & Frontend Build Artifacts
# ---------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
.eslintcache

# ---------------------------------------------------------------------
# IDEs, Editors & Operating System Metadata
# ---------------------------------------------------------------------
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.tmp
*.bak
